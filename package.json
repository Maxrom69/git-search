{
  "name": "github-trending-apps-explorer",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --use-system-ca --watch server/index.js",
    "dev:web": "vite --host 0.0.0.0",
    "build": "vite build",
    "start": "node --use-system-ca server/index.js",
    "test": "npm run test:unit && npm run test:ui",
    "test:unit": "node --test tests/*.test.js",
    "test:ui": "vitest run --config vitest.config.js"
  },
  "dependencies": {
    "@vercel/speed-insights": "^2.0.0",
    "cheerio": "^1.1.2",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "concurrently": "^9.2.1",
    "jsdom": "^30.1.3",
    "vite": "^7.1.10",
    "vitest": "^5.0.5"
  }
}
